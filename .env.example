# Скопируйте в .env и заполните. Файл .env не попадает в git.
PORT=3000

# ── База данных ──
# PostgreSQL (на хостинге — адрес управляемой БД). Если пусто — SQLite в файле data/app.db
DATABASE_URL=
# 1 — если хостинг требует SSL-подключения к БД
DATABASE_SSL=
# Только для docker-compose.yml: пароль встроенного Postgres
POSTGRES_PASSWORD=

# ── Почта (коды подтверждения) ──
# Без SMTP коды печатаются в консоль сервера — удобно для проверки, но не для живого сайта.
# Яндекс 360: smtp.yandex.ru, порт 465, пароль приложения. Mail.ru: smtp.mail.ru, 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Пространство <no-reply@your-domain.ru>"

# ── ИИ-ассистент: заполните ОДИН из вариантов ──

# Вариант 1: YandexGPT (Yandex Cloud) — рекомендуется
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# yandexgpt-lite/latest — дешевле и быстрее, yandexgpt/latest — умнее
YANDEX_MODEL=yandexgpt-lite/latest

# Вариант 2: GigaChat (Сбер). Нужен сертификат Минцифры, см. README
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# Если заполнены оба — выбрать явно: yandex | gigachat
AI_PROVIDER=

# ── Магазин ──
# Цена подарочной упаковки, ₽
GIFT_WRAP_PRICE=300

# ── Прочее ──
# Сервер стоит за nginx / балансировщиком хостинга
TRUST_PROXY=1
# Попыток входа/регистрации в минуту с одного IP
AUTH_RATE_LIMIT=10
# Для будущего iOS-приложения
ALLOWED_ORIGINS=capacitor://localhost
