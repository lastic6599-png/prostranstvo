# Скопируйте в .env и заполните. Файл .env не попадает в git.
PORT=3000

# ── ИИ-ассистент: заполните ОДИН из вариантов ──

# Вариант 1: YandexGPT (Yandex Cloud) — рекомендуется
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# yandexgpt-lite/latest — дешевле и быстрее, yandexgpt/latest — умнее
YANDEX_MODEL=yandexgpt-lite/latest

# Вариант 2: GigaChat (Сбер). Нужен сертификат Минцифры, см. README
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# Если заполнены оба — выбрать явно: yandex | gigachat
AI_PROVIDER=

# Сервер стоит за nginx / балансировщиком хостинга
TRUST_PROXY=1

# Для будущего iOS-приложения
ALLOWED_ORIGINS=capacitor://localhost
